+package de.rub.nds.x509attacker.config;
+
+import jakarta.xml.bind.annotation.adapters.XmlAdapter;
+import org.joda.time.DateTime;
+
+/**
+ * Local patch for IronSocketLayer's TLS-Anvil run: without an adapter JAXB writes a Joda DateTime
+ * as an empty element and reads it back with DateTime's no-argument constructor, the current
+ * time, so a configuration copied through XML gets a certificate valid from now until now.
+ */
+public class DateTimeAdapter extends XmlAdapter<String, DateTime> {
+    @Override
+    public DateTime unmarshal(String value) {
+        return value == null || value.isEmpty() ? null : DateTime.parse(value);
+    }
+
+    @Override
+    public String marshal(DateTime value) {
+        return value == null ? null : value.toString();
+    }
+}
